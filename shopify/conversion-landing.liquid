{%- style -%}

/* ─────────────────────────────────────────────────────────────
   CONVERSION LANDING — Scoped CSS
   Accent: #4F46E5 (indigo). Override via --cl-accent.
───────────────────────────────────────────────────────────── */

.conversion-landing {
  --cl-accent:        #4F46E5;
  --cl-accent-dark:   #3730A3;
  --cl-accent-light:  #EEF2FF;
  --cl-black:         #0F0F0F;
  --cl-white:         #FFFFFF;
  --cl-muted:         #6B7280;
  --cl-border:        #E5E7EB;
  --cl-surface:       #F9FAFB;
  --cl-gold:          #F59E0B;
  --cl-success:       #059669;

  --cl-radius:        0.75rem;
  --cl-radius-sm:     0.5rem;

  --cl-section-gap:   4rem;
  --cl-inner-gap:     2rem;

  font-family: var(--font-body-family, system-ui, sans-serif);
  color: var(--cl-black);
  line-height: 1.6;
}

/* ── Shared typography ────────────────────────────────────── */

.cl-eyebrow {
  display: inline-block;
  font-size: 0.8125rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--cl-accent);
  margin: 0 0 0.75rem;
}

.cl-section-heading {
  font-family: var(--font-heading-family, system-ui, sans-serif);
  font-size: clamp(1.625rem, 4vw, 2.5rem);
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -0.02em;
  color: var(--cl-black);
  margin: 0 0 1rem;
}

.cl-section-heading--center { text-align: center; }

.cl-section-sub {
  font-size: 1.0625rem;
  color: var(--cl-muted);
  margin: 0 0 var(--cl-inner-gap);
}

.cl-section-sub--center { text-align: center; }

.cl-prose {
  font-size: 1.0625rem;
  color: #374151;
  line-height: 1.75;
  margin: 0 0 1.5rem;
}

.cl-prose p { margin: 0 0 1rem; }
.cl-prose p:last-child { margin-bottom: 0; }

/* ── 1. HERO ──────────────────────────────────────────────── */

.cl-hero {
  position: relative;
  overflow: hidden;
  background: var(--cl-black);
  min-height: 72vw;
}

@media (min-width: 750px) {
  .cl-hero { min-height: 520px; }
}

@media (min-width: 990px) {
  .cl-hero { min-height: 640px; }
}

.cl-hero__media {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.cl-hero__media img,
.cl-hero__placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.cl-hero__media::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(0,0,0,0.15) 0%,
    rgba(0,0,0,0.65) 100%
  );
}

.cl-hero__content {
  position: relative;
  z-index: 1;
  padding: 5rem 1.5rem 3.5rem;
  max-width: 680px;
}

@media (min-width: 750px) {
  .cl-hero__content {
    padding: 6rem 2rem 4rem;
  }
}

.cl-hero__content .cl-eyebrow {
  color: #A5B4FC;
}

.cl-hero__heading {
  font-family: var(--font-heading-family, system-ui, sans-serif);
  font-size: clamp(2rem, 5.5vw, 3.5rem);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.03em;
  color: var(--cl-white);
  margin: 0 0 1rem;
}

.cl-hero__sub {
  font-size: clamp(1rem, 2vw, 1.1875rem);
  color: rgba(255,255,255,0.8);
  margin: 0 0 2rem;
  max-width: 520px;
}

/* ── 2. PROBLEM ───────────────────────────────────────────── */

.cl-problem {
  padding: var(--cl-section-gap) 1.5rem;
}

@media (min-width: 750px) {
  .cl-problem { padding-left: 2rem; padding-right: 2rem; }
}

.cl-problem__inner {
  max-width: 700px;
  margin: 0 auto;
  text-align: center;
}

.cl-pain-list {
  list-style: none;
  padding: 0;
  margin: 1.75rem 0 0;
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
  text-align: left;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
}

.cl-pain-list__item {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  font-size: 1rem;
  color: #374151;
  padding: 0.875rem 1.125rem;
  background: #FEF2F2;
  border: 1px solid #FECACA;
  border-radius: var(--cl-radius-sm);
}

.cl-pain-list__icon {
  color: #DC2626;
  font-size: 1rem;
  flex-shrink: 0;
  margin-top: 0.1rem;
  font-weight: 700;
}

/* ── 3. SOLUTION ──────────────────────────────────────────── */

.cl-solution {
  padding: var(--cl-section-gap) 1.5rem;
  background: var(--cl-surface);
}

@media (min-width: 750px) {
  .cl-solution { padding-left: 2rem; padding-right: 2rem; }
}

.cl-solution__grid {
  display: grid;
  gap: 2.5rem;
  align-items: center;
}

@media (min-width: 990px) {
  .cl-solution__grid {
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
}

.cl-solution__media {
  border-radius: var(--cl-radius);
  overflow: hidden;
  background: var(--cl-border);
  aspect-ratio: 4 / 3;
}

.cl-solution__media img,
.cl-solution__placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.cl-solution__copy { display: flex; flex-direction: column; gap: 0.25rem; }
.cl-solution__copy .cl-section-heading { margin-bottom: 0.75rem; }

/* ── 4. BENEFITS ──────────────────────────────────────────── */

.cl-benefits {
  padding: var(--cl-section-gap) 1.5rem;
}

@media (min-width: 750px) {
  .cl-benefits { padding-left: 2rem; padding-right: 2rem; }
}

.cl-benefits__grid {
  list-style: none;
  padding: 0;
  margin: 2.5rem 0 0;
  display: grid;
  gap: 1.25rem;
}

@media (min-width: 600px) {
  .cl-benefits__grid { grid-template-columns: 1fr 1fr; }
}

@media (min-width: 990px) {
  .cl-benefits__grid { grid-template-columns: repeat(3, 1fr); }
}

.cl-benefit-card {
  background: var(--cl-white);
  border: 1px solid var(--cl-border);
  border-radius: var(--cl-radius);
  padding: 1.75rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}

.cl-benefit-card:hover {
  box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  transform: translateY(-2px);
}

.cl-benefit-card__icon {
  font-size: 1.75rem;
  line-height: 1;
  color: var(--cl-accent);
  margin-bottom: 0.25rem;
}

.cl-benefit-card__heading {
  font-family: var(--font-heading-family, system-ui, sans-serif);
  font-size: 1.0625rem;
  font-weight: 700;
  color: var(--cl-black);
  margin: 0;
}

.cl-benefit-card__body {
  font-size: 0.9375rem;
  color: #374151;
  line-height: 1.65;
  margin: 0;
}

.cl-benefit-card__vs {
  font-size: 0.8125rem;
  color: var(--cl-muted);
  font-style: italic;
  margin: 0.5rem 0 0;
  padding-top: 0.75rem;
  border-top: 1px solid var(--cl-border);
}

/* ── 5. SOCIAL PROOF ──────────────────────────────────────── */

.cl-proof {
  padding: var(--cl-section-gap) 1.5rem;
  background: var(--cl-surface);
}

@media (min-width: 750px) {
  .cl-proof { padding-left: 2rem; padding-right: 2rem; }
}

.cl-proof__summary {
  text-align: center;
  font-size: 1rem;
  color: var(--cl-muted);
  margin: 0.5rem 0 2.5rem;
  font-weight: 500;
}

.cl-proof__grid {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 1.25rem;
}

@media (min-width: 750px) {
  .cl-proof__grid { grid-template-columns: repeat(3, 1fr); }
}

.cl-testimonial {
  background: var(--cl-white);
  border: 1px solid var(--cl-border);
  border-radius: var(--cl-radius);
  padding: 1.75rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
}

.cl-testimonial__stars {
  color: var(--cl-gold);
  font-size: 1.0625rem;
  letter-spacing: 0.05em;
  line-height: 1;
}

.cl-testimonial__quote {
  font-size: 0.9375rem;
  color: #374151;
  line-height: 1.7;
  font-style: italic;
  margin: 0;
  flex: 1;
}

.cl-testimonial__result {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--cl-success);
  background: #ECFDF5;
  border: 1px solid #A7F3D0;
  border-radius: 999px;
  padding: 0.3rem 0.875rem;
  display: inline-block;
  margin: 0;
}

.cl-testimonial__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  flex-wrap: wrap;
  padding-top: 0.875rem;
  border-top: 1px solid var(--cl-border);
  margin-top: auto;
}

.cl-testimonial__name {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--cl-black);
  font-style: normal;
}

.cl-testimonial__timeframe {
  font-size: 0.8125rem;
  color: var(--cl-muted);
}

/* ── 6. CTA ───────────────────────────────────────────────── */

.cl-cta {
  background: var(--cl-black);
  padding: 5rem 1.5rem;
}

@media (min-width: 750px) {
  .cl-cta { padding: 6rem 2rem; }
}

.cl-cta__inner {
  max-width: 680px;
  margin: 0 auto;
  text-align: center;
}

.cl-cta__heading {
  font-family: var(--font-heading-family, system-ui, sans-serif);
  font-size: clamp(1.75rem, 4vw, 2.75rem);
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.025em;
  color: var(--cl-white);
  margin: 0 0 1.25rem;
}

.cl-cta__body {
  font-size: 1.0625rem;
  color: rgba(255,255,255,0.7);
  line-height: 1.75;
  margin: 0 0 1rem;
  max-width: 560px;
  margin-left: auto;
  margin-right: auto;
}

.cl-cta__actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  margin-top: 2.25rem;
}

.cl-cta__guarantee {
  font-size: 0.875rem;
  color: rgba(255,255,255,0.5);
  margin: 0;
}

/* ── Buttons ──────────────────────────────────────────────── */

.conversion-landing .button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  font-family: var(--font-body-family, system-ui, sans-serif);
  font-size: 1rem;
  font-weight: 600;
  border-radius: var(--cl-radius-sm);
  padding: 0.875rem 2rem;
  text-decoration: none;
  transition: all 0.2s ease;
  cursor: pointer;
  border: 2px solid transparent;
  letter-spacing: 0.01em;
  white-space: nowrap;
}

.conversion-landing .button--primary {
  background: var(--cl-accent);
  color: var(--cl-white);
  border-color: var(--cl-accent);
  box-shadow: 0 4px 14px rgba(79, 70, 229, 0.35);
}

.conversion-landing .button--primary:hover {
  background: var(--cl-accent-dark);
  border-color: var(--cl-accent-dark);
  box-shadow: 0 6px 20px rgba(79, 70, 229, 0.45);
  transform: translateY(-1px);
}

.conversion-landing .button--secondary {
  background: transparent;
  color: var(--cl-accent);
  border-color: var(--cl-accent);
}

.conversion-landing .button--secondary:hover {
  background: var(--cl-accent-light);
}

/* CTA section: invert button to stand out on dark */
.cl-cta .button--primary {
  background: var(--cl-accent);
  border-color: var(--cl-accent);
  padding: 1rem 2.5rem;
  font-size: 1.0625rem;
  box-shadow: 0 6px 24px rgba(79, 70, 229, 0.5);
}

.cl-cta .button--primary:hover {
  background: var(--cl-accent-dark);
  border-color: var(--cl-accent-dark);
  box-shadow: 0 8px 30px rgba(79, 70, 229, 0.6);
  transform: translateY(-2px);
}

{%- endstyle -%}

<div class="conversion-landing" id="section-{{ section.id }}">

  {%- comment -%} ─── 1. HERO ─────────────────────────────────────────── {%- endcomment -%}
  <section class="cl-hero">
    <div class="cl-hero__media">
      {%- if section.settings.hero_image != blank -%}
        {{
          section.settings.hero_image
          | image_url: width: 1500
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '375, 750, 1100, 1500',
            sizes: '100vw',
            alt: section.settings.hero_image.alt | escape
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'cl-hero__placeholder' }}
      {%- endif -%}
    </div>

    <div class="cl-hero__content page-width">
      {%- if section.settings.hero_eyebrow != blank -%}
        <p class="cl-eyebrow">{{ section.settings.hero_eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.hero_heading != blank -%}
        <h1 class="cl-hero__heading">{{ section.settings.hero_heading }}</h1>
      {%- endif -%}

      {%- if section.settings.hero_subheading != blank -%}
        <p class="cl-hero__sub">{{ section.settings.hero_subheading }}</p>
      {%- endif -%}

      {%- if section.settings.hero_cta_label != blank -%}
        <a
          href="{{ section.settings.hero_cta_url }}"
          class="button button--primary"
        >
          {{ section.settings.hero_cta_label }}
        </a>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ─── 2. PROBLEM ──────────────────────────────────────── {%- endcomment -%}
  {%- if section.settings.problem_heading != blank or section.settings.problem_body != blank -%}
  <section class="cl-problem page-width">
    <div class="cl-problem__inner">
      {%- if section.settings.problem_heading != blank -%}
        <h2 class="cl-section-heading">{{ section.settings.problem_heading }}</h2>
      {%- endif -%}

      {%- if section.settings.problem_body != blank -%}
        <div class="cl-prose">{{ section.settings.problem_body }}</div>
      {%- endif -%}

      {%- assign pain_blocks = section.blocks | where: 'type', 'pain_point' -%}
      {%- if pain_blocks.size > 0 -%}
        <ul class="cl-pain-list">
          {%- for block in pain_blocks -%}
            <li class="cl-pain-list__item" {{ block.shopify_attributes }}>
              {%- if block.settings.pain_icon != blank -%}
                <span class="cl-pain-list__icon" aria-hidden="true">{{ block.settings.pain_icon }}</span>
              {%- endif -%}
              <span>{{ block.settings.pain_text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ─── 3. SOLUTION ─────────────────────────────────────── {%- endcomment -%}
  {%- if section.settings.solution_heading != blank -%}
  <section class="cl-solution page-width">
    <div class="cl-solution__grid">

      <div class="cl-solution__media">
        {%- if section.settings.solution_image != blank -%}
          {{
            section.settings.solution_image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '375, 600, 900',
              sizes: '(min-width: 990px) 50vw, 100vw',
              alt: section.settings.solution_image.alt | escape
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'cl-solution__placeholder' }}
        {%- endif -%}
      </div>

      <div class="cl-solution__copy">
        {%- if section.settings.solution_eyebrow != blank -%}
          <p class="cl-eyebrow">{{ section.settings.solution_eyebrow }}</p>
        {%- endif -%}

        <h2 class="cl-section-heading">{{ section.settings.solution_heading }}</h2>

        {%- if section.settings.solution_body != blank -%}
          <div class="cl-prose">{{ section.settings.solution_body }}</div>
        {%- endif -%}

        {%- if section.settings.solution_cta_label != blank -%}
          <a
            href="{{ section.settings.solution_cta_url }}"
            class="button button--secondary"
          >
            {{ section.settings.solution_cta_label }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ─── 4. BENEFITS ─────────────────────────────────────── {%- endcomment -%}
  {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
  {%- if benefit_blocks.size > 0 -%}
  <section class="cl-benefits page-width">
    {%- if section.settings.benefits_heading != blank -%}
      <h2 class="cl-section-heading cl-section-heading--center">
        {{ section.settings.benefits_heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.benefits_subheading != blank -%}
      <p class="cl-section-sub cl-section-sub--center">
        {{ section.settings.benefits_subheading }}
      </p>
    {%- endif -%}

    <ul class="cl-benefits__grid">
      {%- for block in benefit_blocks -%}
        <li class="cl-benefit-card" {{ block.shopify_attributes }}>
          {%- if block.settings.benefit_icon != blank -%}
            <div class="cl-benefit-card__icon" aria-hidden="true">
              {{ block.settings.benefit_icon }}
            </div>
          {%- endif -%}

          {%- if block.settings.benefit_heading != blank -%}
            <h3 class="cl-benefit-card__heading">{{ block.settings.benefit_heading }}</h3>
          {%- endif -%}

          {%- if block.settings.benefit_body != blank -%}
            <p class="cl-benefit-card__body">{{ block.settings.benefit_body }}</p>
          {%- endif -%}

          {%- if block.settings.benefit_vs != blank -%}
            <p class="cl-benefit-card__vs">{{ block.settings.benefit_vs }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </section>
  {%- endif -%}

  {%- comment -%} ─── 5. SOCIAL PROOF ─────────────────────────────────── {%- endcomment -%}
  {%- assign testimonial_blocks = section.blocks | where: 'type', 'testimonial' -%}
  {%- if testimonial_blocks.size > 0 -%}
  <section class="cl-proof page-width">
    {%- if section.settings.proof_heading != blank -%}
      <h2 class="cl-section-heading cl-section-heading--center">
        {{ section.settings.proof_heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.proof_rating_summary != blank -%}
      <p class="cl-proof__summary">{{ section.settings.proof_rating_summary }}</p>
    {%- endif -%}

    <ul class="cl-proof__grid">
      {%- for block in testimonial_blocks -%}
        <li class="cl-testimonial" {{ block.shopify_attributes }}>

          <div class="cl-testimonial__stars" aria-label="{{ block.settings.star_count }} out of 5 stars">
            {%- assign stars = block.settings.star_count | default: 5 -%}
            {%- for i in (1..stars) -%}
              <span aria-hidden="true">★</span>
            {%- endfor -%}
          </div>

          {%- if block.settings.testimonial_quote != blank -%}
            <blockquote class="cl-testimonial__quote">
              {{ block.settings.testimonial_quote }}
            </blockquote>
          {%- endif -%}

          {%- if block.settings.testimonial_result != blank -%}
            <p class="cl-testimonial__result">{{ block.settings.testimonial_result }}</p>
          {%- endif -%}

          <footer class="cl-testimonial__footer">
            {%- if block.settings.testimonial_name != blank -%}
              <cite class="cl-testimonial__name">{{ block.settings.testimonial_name }}</cite>
            {%- endif -%}
            {%- if block.settings.testimonial_timeframe != blank -%}
              <span class="cl-testimonial__timeframe">{{ block.settings.testimonial_timeframe }}</span>
            {%- endif -%}
          </footer>

        </li>
      {%- endfor -%}
    </ul>
  </section>
  {%- endif -%}

  {%- comment -%} ─── 6. CTA ──────────────────────────────────────────── {%- endcomment -%}
  {%- if section.settings.cta_heading != blank -%}
  <section class="cl-cta">
    <div class="cl-cta__inner page-width">
      <h2 class="cl-cta__heading">{{ section.settings.cta_heading }}</h2>

      {%- if section.settings.cta_body_1 != blank -%}
        <p class="cl-cta__body">{{ section.settings.cta_body_1 }}</p>
      {%- endif -%}

      {%- if section.settings.cta_body_2 != blank -%}
        <p class="cl-cta__body">{{ section.settings.cta_body_2 }}</p>
      {%- endif -%}

      {%- if section.settings.cta_primary_label != blank -%}
        <div class="cl-cta__actions">
          <a
            href="{{ section.settings.cta_primary_url }}"
            class="button button--primary"
          >
            {{ section.settings.cta_primary_label }}
          </a>

          {%- if section.settings.cta_guarantee != blank -%}
            <p class="cl-cta__guarantee">{{ section.settings.cta_guarantee }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
  {%- endif -%}

</div>

{%- comment -%} ─── STICKY CTA CSS additions ─────────────────────────────── {%- endcomment -%}
{%- style -%}

/* ── Fade-in animation base ──────────────────────────────── */

.cl-fade {
  opacity: 0;
  transform: translateY(22px);
  transition: opacity 0.55s ease, transform 0.55s ease;
}

.cl-fade.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.cl-fade-delay-1 { transition-delay: 0.1s; }
.cl-fade-delay-2 { transition-delay: 0.2s; }
.cl-fade-delay-3 { transition-delay: 0.3s; }

/* ── Sticky bar ──────────────────────────────────────────── */

.cl-sticky-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: rgba(15, 15, 15, 0.96);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 0.875rem 1.25rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  box-shadow: 0 -4px 24px rgba(0,0,0,0.25);
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  will-change: transform;
}

.cl-sticky-bar.is-visible {
  transform: translateY(0);
}

.cl-sticky-bar__text {
  font-size: 0.9375rem;
  font-weight: 600;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cl-sticky-bar .button--primary {
  background: var(--cl-accent);
  color: #fff;
  border-color: var(--cl-accent);
  padding: 0.6875rem 1.5rem;
  font-size: 0.9375rem;
  flex-shrink: 0;
  box-shadow: none;
}

.cl-sticky-bar .button--primary:hover {
  background: var(--cl-accent-dark);
  border-color: var(--cl-accent-dark);
  transform: none;
  box-shadow: none;
}

@media (min-width: 750px) {
  .cl-sticky-bar {
    padding: 1rem 2rem;
    justify-content: center;
    gap: 2rem;
  }
  .cl-sticky-bar__text { font-size: 1rem; }
}

{%- endstyle -%}

{%- comment -%} ─── STICKY BAR HTML ──────────────────────────────────────── {%- endcomment -%}
<div
  class="cl-sticky-bar conversion-landing"
  id="cl-sticky-{{ section.id }}"
  aria-hidden="true"
  role="region"
  aria-label="Sticky call to action"
>
  {%- if section.settings.hero_heading != blank -%}
    <span class="cl-sticky-bar__text">{{ section.settings.hero_heading | truncate: 48 }}</span>
  {%- endif -%}
  {%- if section.settings.hero_cta_label != blank -%}
    <a
      href="{{ section.settings.hero_cta_url }}"
      class="button button--primary"
    >
      {{ section.settings.hero_cta_label }}
    </a>
  {%- endif -%}
</div>

<script>
(function () {
  'use strict';

  var sectionId = {{ section.id | json }};
  var ROOT      = document.getElementById('section-' + sectionId);
  if (!ROOT) return;

  /* ── 1. Fade-in on scroll (Intersection Observer) ──────── */
  var FADE_TARGETS = [
    '.cl-hero__content',
    '.cl-problem__inner',
    '.cl-solution__copy',
    '.cl-solution__media',
    '.cl-benefit-card',
    '.cl-testimonial',
    '.cl-cta__inner',
    '.cl-section-heading',
    '.cl-pain-list__item'
  ].join(',');

  ROOT.querySelectorAll(FADE_TARGETS).forEach(function (el, i) {
    el.classList.add('cl-fade');
    if (i % 3 === 1) el.classList.add('cl-fade-delay-1');
    if (i % 3 === 2) el.classList.add('cl-fade-delay-2');
  });

  if ('IntersectionObserver' in window) {
    var fadeObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          fadeObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

    ROOT.querySelectorAll('.cl-fade').forEach(function (el) {
      fadeObserver.observe(el);
    });
  } else {
    /* Fallback: just show everything */
    ROOT.querySelectorAll('.cl-fade').forEach(function (el) {
      el.classList.add('is-visible');
    });
  }

  /* ── 2. Sticky CTA bar ──────────────────────────────────── */
  var stickyBar  = document.getElementById('cl-sticky-' + sectionId);
  var heroSection = ROOT.querySelector('.cl-hero');

  if (stickyBar && heroSection) {
    var stickyObserver = new IntersectionObserver(function (entries) {
      var heroVisible = entries[0].isIntersecting;
      stickyBar.classList.toggle('is-visible', !heroVisible);
      stickyBar.setAttribute('aria-hidden', heroVisible ? 'true' : 'false');
    }, { threshold: 0 });

    stickyObserver.observe(heroSection);
  }

  /* ── 3. Smooth scroll for anchor links inside this section ─ */
  ROOT.querySelectorAll('a[href^="#"]').forEach(function (anchor) {
    anchor.addEventListener('click', function (e) {
      var target = document.querySelector(this.getAttribute('href'));
      if (!target) return;
      e.preventDefault();
      var offset = 80; /* account for sticky header */
      var top = target.getBoundingClientRect().top + window.scrollY - offset;
      window.scrollTo({ top: top, behavior: 'smooth' });
    });
  });

  /* Also wire solution CTA → solution section if href is '#solution' */
  var solutionAnchor = ROOT.querySelector('.cl-hero__content .button[href="#cl-solution-' + sectionId + '"]');
  if (!solutionAnchor) {
    /* Auto-target the solution section with a generated ID */
    var solutionSection = ROOT.querySelector('.cl-solution');
    if (solutionSection) {
      var solId = 'cl-solution-' + sectionId;
      solutionSection.id = solId;
    }
  }

})();
</script>

